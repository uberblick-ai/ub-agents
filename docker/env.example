# Repository to run the loop on, as owner/name.
UB_AGENTS_REPO=your-org/your-project

# Launcher account token (a dedicated agent account with write access).
# Fine-grained: contents, issues, pull requests, discussions read/write; actions, checks read.
GH_TOKEN=

# Claude: a subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex: your ChatGPT login as one line, from `jq -c . ~/.codex/auth.json`, or an API key.
# Only read on first start; later logins live in the home volume.
CODEX_AUTH_JSON=
# OPENAI_API_KEY=

# Optional: commit identity (defaults to the token's account) and the host name in claims.
# GIT_USER_NAME=
# GIT_USER_EMAIL=
# UB_AGENTS_HOST=docker-launcher
